{
  "name": "signalk-weather-router-plus",
  "version": "0.2.0-beta.1",
  "description": "Signal K plugin: standalone open-water weather routing (isochrone) using ECMWF open-data forecasts decoded in-process, GSHHG land avoidance, vessel polars. Publishes routes to the Signal K Resources API and registers as a Weather API provider.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "node scripts/run-tests.mjs",
    "test:corpus": "node --import tsx tools/verify_grib_corpus.ts",
    "build:water-grid": "node --import tsx tools/build_water_grid.ts",
    "check:water-grid": "node --import tsx tools/check_water_grid.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint \"src/**/*.ts\" \"public/*.js\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"public/*.js\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\" --ignore-unknown",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\" --ignore-unknown",
    "coverage": "c8 --reporter=text --reporter=lcov npm test",
    "ci": "npm run format:check && npm run lint"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-weather",
    "signalk-category-route-planning",
    "weather-routing",
    "ecmwf",
    "isochrone",
    "signalk-plugin-configurator"
  ],
  "author": "Maurice Tamman",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motamman/signalk-weather-router-plus.git"
  },
  "bugs": {
    "url": "https://github.com/motamman/signalk-weather-router-plus/issues"
  },
  "homepage": "https://github.com/motamman/signalk-weather-router-plus#readme",
  "engines": {
    "node": ">=20.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@signalk/server-api": "^2.24.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "c8": "^12.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "tsx": "^4.7.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "public",
    "data",
    "README.md",
    "LICENSE",
    "NOTICE",
    "licenses",
    "CHANGELOG.md",
    "WHATSNEW.md"
  ],
  "bin": {
    "wrp-route": "dist/cli.js"
  },
  "signalk": {
    "appSupport": "webapp",
    "compatibility": ">=2.24.0",
    "displayName": "Weather Router Plus",
    "appIcon": "icon.png",
    "screenshots": [
      "./public/screenshots/01-route.jpg",
      "./public/screenshots/02-planning.jpg",
      "./public/screenshots/03-layers.jpg",
      "./public/screenshots/04-conditions.jpg",
      "./public/screenshots/05-waypoints.jpg",
      "./public/screenshots/06-polars.jpg"
    ]
  }
}
